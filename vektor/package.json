{
  "name": "vektor",
  "productName": "Вектор",
  "version": "1.0.0",
  "description": "Векторный редактор (аналог CorelDRAW), Фигма, моушн-дизайн и ИИ через Polza",
  "private": true,
  "author": "Вектор",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "npx http-server -p 8080 -c-1 .",
    "build:figma": "node tools/figma/build.mjs",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.vektor.editor",
    "productName": "Вектор",
    "directories": { "output": "release" },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "fonts/**/*",
      "vendor/**/*",
      "figma/**/*",
      "photo/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      { "ext": "vkt", "name": "Документ Вектор", "description": "Документ векторного редактора Вектор", "role": "Editor" },
      { "ext": "fig", "name": "Файл Figma", "description": "Файл Figma — открывается в рабочем пространстве «Фигма»", "role": "Editor" },
      { "ext": "vkm", "name": "Проект моушна", "description": "Проект моушн-дизайна программы Вектор", "role": "Editor" },
      { "ext": "psd", "name": "Файл Photoshop", "description": "Открывается в рабочем пространстве «Фото»", "role": "Editor" }
    ],
    "win": { "icon": "build/icon.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "linux": { "icon": "build/icon.png", "target": ["AppImage"], "category": "Graphics" },
    "mac": { "icon": "build/icon.png", "target": ["zip"], "category": "public.app-category.graphics-design" }
  }
}
