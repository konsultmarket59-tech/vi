{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/drawings/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/platform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Inter, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|orange|cyan|coral|blue|soft|outline)$/]",
        "message": "<Badge> tone must be one of 'navy' | 'orange' | 'cyan' | 'coral' | 'blue' | 'soft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumbs> doesn't accept that prop. Declared props: items, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|loading|disabled|fullWidth|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, loading, disabled, fullWidth, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContractorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|avatar|rating|reviews|location|experience|verified|contract|primaryLabel|secondaryLabel|onPrimary|onSecondary|style|key|ref|className|style|children)$/]",
        "message": "<ContractorCard> doesn't accept that prop. Declared props: name, role, avatar, rating, reviews, location, experience, verified, contract, primaryLabel, secondaryLabel, onPrimary, onSecondary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExplicationRoom'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|name|area|wet|key|ref|className|style|children)$/]",
        "message": "<ExplicationRoom> doesn't accept that prop. Declared props: n, name, area, wet."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|nav|active|onNavigate|onLogo|ctaLabel|onCta|variant|style|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: logoSrc, nav, active, onNavigate, onLogo, ctaLabel, onCta, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<Header> variant must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|ghost)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|defaultValue|onChange|icon|suffix|error|type|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, defaultValue, onChange, icon, suffix, error, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|area|rooms|baths|floors|price|badge|favorite|onFavorite|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: image, title, area, rooms, baths, floors, price, badge, favorite, onFavorite, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:Популярный|Новинка|Акция|Премиум)$/]",
        "message": "<ProjectCard> badge must be one of 'Популярный' | 'Новинка' | 'Акция' | 'Премиум'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|defaultValue|onChange|name|direction|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: options, value, defaultValue, onChange, name, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<Radio> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|step|value|defaultValue|onChange|label|unit|format|style|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: min, max, step, value, defaultValue, onChange, label, unit, format, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|reviews|size|showValue|style|key|ref|className|style|children)$/]",
        "message": "<Rating> doesn't accept that prop. Declared props: value, reviews, size, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|name|area|dims|wet|scale|style|key|ref|className|style|children)$/]",
        "message": "<RoomTag> doesn't accept that prop. Declared props: n, name, area, dims, wet, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|defaultValue|placeholder|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, defaultValue, placeholder, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:draft|review|progress|done)$/]",
        "message": "<StatusDot> status must be one of 'draft' | 'review' | 'progress' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepPath'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<StepPath> doesn't accept that prop. Declared props: steps, current, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|project|stage|sheet|page|pages|date|style|key|ref|className|style|children)$/]",
        "message": "<TitleBlock> doesn't accept that prop. Declared props: logoSrc, project, stage, sheet, page, pages, date, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
