# Скопируйте в .env и заполните. Файл .env в git не кладите.
PUBLIC_URL=https://logikadoma.ru
CRM_ADMIN_EMAIL=admin@logikadoma.ru
CRM_ADMIN_PASSWORD=придумайте-длинный-пароль
ADMIN_KEY=случайная-строка-для-admin.html
# цена верификации проекта архитектором и инженером платформы, ₽
VERIFY_PRICE=15000
# почта для писем компаниям и уведомлений (Яндекс 360, Mail.ru для бизнеса, Unisender Go и т. п.)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@logikadoma.ru
SMTP_PASS=пароль-приложения
SMTP_FROM=noreply@logikadoma.ru
# Telegram-уведомления владельцу (необязательно)
TG_BOT_TOKEN=
TG_OWNER_CHAT=
# Яндекс SmartCaptcha (необязательно; без ключей работают ловушка, токен формы и лимиты)
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
